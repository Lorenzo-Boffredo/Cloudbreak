<Window x:Class="Cloudbreak.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Cloudbreak.Core"
        Title="{c:T settingsTitle}" Width="640" Height="540"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Icon="/cloudbreak.ico"
        Background="{DynamicResource PaperBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Desc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Margin" Value="0,18,0,18"/>
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
        <Style x:Key="Stepper" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StepValue" TargetType="TextBlock">
            <Setter Property="MinWidth" Value="58"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>

        <!-- Section navigation -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="7" Padding="11,0" Background="{TemplateBinding Background}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}"
                                           FontSize="15" Width="18" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter Margin="11,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Background="{DynamicResource StripBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="36" Margin="14,0,0,0">
                    <c:LogoIcon Width="14" Height="14" VerticalAlignment="Center" Ring="{DynamicResource InkBrush}" Dot="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="Cloudbreak" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{c:T applyNow}" Style="{StaticResource Desc}" Margin="18,0,16,18"/>
                <StackPanel Margin="10,14,10,0">
                    <RadioButton x:Name="NavTimer" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE916;"
                                 Content="{c:T navTimer}" Checked="Nav_Click"/>
                    <RadioButton x:Name="NavAlerts" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xEA8F;"
                                 Content="{c:T navAlerts}" Checked="Nav_Click"/>
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE771;"
                                 Content="{c:T navGeneral}" Checked="Nav_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button HorizontalAlignment="Right" Style="{StaticResource CloseTitleButton}" Content="&#xE8BB;"
                    ToolTip="{c:T close}" AutomationProperties.Name="{c:T close}" Click="Close_Click"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                <Grid Margin="30,2,30,26">

                    <!-- ===== Timer ===== -->
                    <StackPanel x:Name="PageTimer">
                        <TextBlock Text="{c:T navTimer}" Style="{StaticResource PageTitle}"/>

                        <!-- One round, drawn to scale -->
                        <Grid Height="10" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="RhythmHold" Width="25*"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition x:Name="RhythmBreak" Width="5*"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="5,2,2,5" Background="{DynamicResource StripHoldBrush}"/>
                            <Border Grid.Column="2" CornerRadius="2,5,5,2" Background="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <TextBlock x:Name="RoundLen" Style="{StaticResource Desc}" Margin="0,0,0,18"/>

                        <DockPanel Style="{StaticResource Row}" Margin="0,0,0,12">
                            <Border DockPanel.Dock="Right" Style="{StaticResource Stepper}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource StepButton}" Content="−" Click="HoldMinus"/>
                                    <TextBlock x:Name="HoldVal" Style="{StaticResource StepValue}"/>
                                    <Button Style="{StaticResource StepButton}" Content="+" Click="HoldPlus"/>
                                </StackPanel>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{c:T hold}"/>
                                <TextBlock Text="{c:T holdDesc}" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}" Margin="0,0,0,14">
                            <Border DockPanel.Dock="Right" Style="{StaticResource Stepper}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource StepButton}" Content="−" Click="BreakMinus"/>
                                    <TextBlock x:Name="BreakVal" Style="{StaticResource StepValue}"/>
                                    <Button Style="{StaticResource StepButton}" Content="+" Click="BreakPlus"/>
                                </StackPanel>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{c:T break}"/>
                                <TextBlock Text="{c:T breakDesc}" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel x:Name="Presets">
                            <RadioButton Style="{StaticResource Chip}" GroupName="preset" Content="25 / 5" Tag="25,5" Click="Preset_Click"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="preset" Content="45 / 5" Tag="45,5" Click="Preset_Click"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="preset" Content="60 / 10" Tag="60,10" Click="Preset_Click"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="preset" Content="90 / 10" Tag="90,10" Click="Preset_Click"/>
                        </WrapPanel>

                        <Border Style="{StaticResource Divider}"/>

                        <DockPanel Style="{StaticResource Row}" Margin="0,0,0,12">
                            <CheckBox x:Name="ActiveOn" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Active_Click"
                                      AutomationProperties.Name="{c:T activeHours}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{c:T activeHours}"/>
                                <TextBlock Text="{c:T activeDesc}" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel x:Name="HoursRow" Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource Stepper}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource StepButton}" Content="−" Click="StartMinus"/>
                                    <TextBlock x:Name="StartVal" Style="{StaticResource StepValue}"/>
                                    <Button Style="{StaticResource StepButton}" Content="+" Click="StartPlus"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="–" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                            <Border Style="{StaticResource Stepper}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource StepButton}" Content="−" Click="EndMinus"/>
                                    <TextBlock x:Name="EndVal" Style="{StaticResource StepValue}"/>
                                    <Button Style="{StaticResource StepButton}" Content="+" Click="EndPlus"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="HoursNote" Style="{StaticResource Desc}"/>
                    </StackPanel>

                    <!-- ===== Alerts ===== -->
                    <StackPanel x:Name="PageAlerts" Visibility="Collapsed">
                        <TextBlock Text="{c:T navAlerts}" Style="{StaticResource PageTitle}"/>

                        <DockPanel Style="{StaticResource Row}" Margin="0,0,0,16">
                            <CheckBox x:Name="NotifyOn" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Toggle_Click"
                                      AutomationProperties.Name="{c:T notif}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{c:T notif}"/>
                                <TextBlock Text="{c:T notifDesc}" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel x:Name="PositionBlock">
                            <DockPanel>
                                <TextBlock x:Name="PosName" DockPanel.Dock="Right" Style="{StaticResource Desc}" VerticalAlignment="Center"/>
                                <TextBlock Text="{c:T posLabel}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"/>
                            </DockPanel>
                            <Grid Margin="0,8,-8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="CornerTL" Style="{StaticResource CornerTile}" GroupName="corner" Tag="tl"
                                             HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Click="Corner_Click"/>
                                <RadioButton x:Name="CornerTR" Grid.Column="1" Style="{StaticResource CornerTile}" GroupName="corner" Tag="tr"
                                             HorizontalContentAlignment="Right" VerticalContentAlignment="Top" Click="Corner_Click"/>
                                <RadioButton x:Name="CornerBL" Grid.Column="2" Style="{StaticResource CornerTile}" GroupName="corner" Tag="bl"
                                             HorizontalContentAlignment="Left" VerticalContentAlignment="Bottom" Click="Corner_Click"/>
                                <RadioButton x:Name="CornerBR" Grid.Column="3" Style="{StaticResource CornerTile}" GroupName="corner" Tag="br"
                                             HorizontalContentAlignment="Right" VerticalContentAlignment="Bottom" Click="Corner_Click"/>
                            </Grid>
                        </StackPanel>

                        <Border Style="{StaticResource Divider}"/>

                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="SoundOn" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Toggle_Click"
                                      AutomationProperties.Name="{c:T sound}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{c:T sound}"/>
                                <TextBlock Text="{c:T soundDesc}" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource Divider}"/>

                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="MiniOn" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Toggle_Click"
                                      AutomationProperties.Name="{c:T mini}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{c:T mini}"/>
                                <TextBlock Text="{c:T miniDesc}" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <!-- ===== General ===== -->
                    <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                        <TextBlock Text="{c:T navGeneral}" Style="{StaticResource PageTitle}"/>

                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="LoginOn" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Toggle_Click"
                                      AutomationProperties.Name="{c:T login}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{c:T login}"/>
                                <TextBlock Text="{c:T loginDesc}" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource Divider}"/>

                        <TextBlock Text="{c:T accent}"/>
                        <TextBlock x:Name="AccentNote" Style="{StaticResource Desc}"/>
                        <Grid Margin="0,10,-8,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <RadioButton x:Name="AccViolet" Style="{StaticResource SegOption}" GroupName="accent" Tag="violet"
                                         Margin="0,0,8,0" Click="Accent_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="VioletDot" Width="14" Height="14" Margin="0,0,9,0"/>
                                    <TextBlock Text="{c:T accViolet}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="AccWindows" Grid.Column="1" Style="{StaticResource SegOption}" GroupName="accent" Tag="windows"
                                         Margin="0,0,8,0" Click="Accent_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="WindowsDot" Width="14" Height="14" Margin="0,0,9,0"/>
                                    <TextBlock Text="{c:T accWin}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>

                        <Border Style="{StaticResource Divider}"/>

                        <TextBlock Text="{c:T language}"/>
                        <TextBlock Text="{c:T langDesc}" Style="{StaticResource Desc}"/>
                        <Grid Margin="0,10,-8,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <RadioButton x:Name="LangAuto" Style="{StaticResource SegOption}" GroupName="lang" Tag="auto"
                                         HorizontalContentAlignment="Center" Margin="0,0,8,0" Content="{c:T langAuto}" Click="Lang_Click"/>
                            <RadioButton x:Name="LangEn" Grid.Column="1" Style="{StaticResource SegOption}" GroupName="lang" Tag="en"
                                         HorizontalContentAlignment="Center" Margin="0,0,8,0" Content="English" Click="Lang_Click"/>
                            <RadioButton x:Name="LangIt" Grid.Column="2" Style="{StaticResource SegOption}" GroupName="lang" Tag="it"
                                         HorizontalContentAlignment="Center" Margin="0,0,8,0" Content="Italiano" Click="Lang_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
